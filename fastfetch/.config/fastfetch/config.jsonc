// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/kitten.txt", // Path to your logo file
        "type": "auto",                    // 'auto' detects the best protocol for your terminal
        "width": 12,                       // Adjust width (in characters)
        "padding": {
            "top": 1,
            "right": 4,
            "left": 3
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "{#31}user    {#keys}",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "type": "command",
            "key": "{#33}os age  {#keys}",
            "keyColor": "magenta",
            "text": "printf \"\\e[0m%s days\\e[0m\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\""
        },
        {
            "key": "{#34}uptime  {#keys}",
            "type": "uptime"
        },
        {
            "key": "{#34}distro  {#keys}",
            "type": "os"
        },
        {
            "key": "{#35} kernel  {#keys}",
            "type": "kernel"
        },
        {
            "key": "{#36}wm      {#keys}",
            "type": "wm"
        },
        {
            "key": "{#36}desktop {#keys}",
            "type": "de"
        },
        {
            "key": "{#33}cpu     {#keys}",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "{#34}disk    {#keys}",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "{#36}memory  {#keys}",
            "type": "memory"
        },
        {
            "key": "{#39}colors  {#keys}",
            "type": "colors",
            "symbol": "circle"
        },
    ]
}
